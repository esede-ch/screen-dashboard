# Adresse EXACTE utilisée dans le navigateur (sans chemin).
# Exemple IP : http://192.168.1.50:8090
# Exemple proxy HTTPS : https://ecrans.esede.ch
DASHBOARD_PUBLIC_URL=https://ecrans.esede.ch
DASHBOARD_PORT=443
DASHBOARD_BIND_IP=0.0.0.0

LDAP_URI=ldap://192.168.1.7:389
LDAP_BASE_DN=dc=ldap,dc=esede,dc=lan
LDAP_GROUP_DN=cn=screen,cn=groups,dc=ldap,dc=esede,dc=lan
LDAP_LOGIN_ATTRIBUTE=uid
LDAP_USER_FILTER=(objectClass=person)
# Exception autorisée pour le certificat autosigné du LDAP esede.
# Le transport reste chiffré par StartTLS. Avec un certificat valide : true.
LDAP_TLS_VERIFY=false
LDAP_CA_FILE=
# Aucun compte de lecture nécessaire pour l’annuaire esede actuel.
LDAP_BIND_DN=
LDAP_BIND_PASSWORD_FILE=
